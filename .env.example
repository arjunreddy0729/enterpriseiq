# ---------------------------------------------------------------------------
# EnterpriseIQ configuration
#
#   cp .env.example .env
#
# .env is gitignored and MUST NEVER be committed. This file is the committed
# template and must never contain a real secret.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
# console = human-readable (local dev), json = structured (production/CI)
LOG_FORMAT=console
API_V1_PREFIX=/api/v1

# Comma-separated origins allowed to call the API from a browser.
# The single-file demo page is served from the API itself, so this only
# matters once the Next.js frontend arrives in Week 2.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL ------------------------------------------------------------
# POSTGRES_HOST is overridden to "db" by docker-compose. Leave it as localhost
# so that running the API directly on your machine also works.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=enterpriseiq
POSTGRES_PASSWORD=enterpriseiq
POSTGRES_DB=enterpriseiq
DB_ECHO=false

# Host port mappings used by docker-compose only. Change these if another
# project on your machine already owns the port - `docker compose up` fails
# with "port is already allocated" rather than picking a free one.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000

# --- Embeddings (local, free, no API calls) --------------------------------
# BAAI/bge-base-en-v1.5  -> 768 dimensions (default, better quality)
# BAAI/bge-small-en-v1.5 -> 384 dimensions (faster, lower RAM)
#
# IMPORTANT: EMBEDDING_DIM must match the model. Changing either one after
# the database has been created requires a re-index migration - see
# docs/architecture.md. /readyz will fail loudly if the configured dimension
# does not match the dimension the chunks.embedding column was created with.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
# BGE models require this prefix on QUERIES ONLY (never on documents).
# Omitting it costs several points of retrieval quality.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# --- Reranking (local, free; V2) -------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=false

# --- Anthropic (the ONLY paid component) -----------------------------------
# Get a key at https://console.anthropic.com/ and paste it into .env, NOT here.
# The key is read server-side only. It is never sent to the frontend and never
# appears in an API response.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=2048

# --- Retrieval tuning ------------------------------------------------------
RETRIEVAL_KEYWORD_TOP_K=50
RETRIEVAL_VECTOR_TOP_K=50
RETRIEVAL_FUSION_TOP_K=30
RETRIEVAL_RERANK_TOP_K=6
RRF_K=60
CONTEXT_TOKEN_BUDGET=3000

# --- Chunking --------------------------------------------------------------
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60

# --- Corpus / seeding ------------------------------------------------------
# Leave CORPUS_DIR unset for local runs: it defaults to <repo-root>/corpus,
# which is an absolute path and therefore independent of your working
# directory. docker-compose overrides it to /corpus.
# CORPUS_DIR=/absolute/path/to/corpus
SEED_ON_STARTUP=true
